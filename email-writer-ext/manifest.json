{
    "name": "Email Extension",
    "description": "AI-powered email assistant that helps you write and manage emails efficiently.",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [
    "storage",
    "activeTab"
    ],
    "host_permissions": [
    "http://localhost:8080/*",
    "*://mail.google.com/*"
    ],
    "content_scripts": [
    {
        "matches": ["*://mail.google.com/*"],
        "js": ["content.js"],
        "css": ["content.css"],
        "run_at": "document_end"
    }
    ],
    "web_accessible_resources": [
    {
        "resources": ["icons/*"],
        "matches": ["*://mail.google.com/*"]
    }
    ],
    "action": {
    "default_title": "Email Extension"
    }
}